{
  "name": "kirian-caumes-website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x.x"
  },
  "scripts": {
    "build": "next build",
    "cspell": "npx cspell ./ --no-progress --dot --gitignore",
    "dev": "next dev",
    "prepare": "husky",
    "start": "next start",
    "eslint:fix": "eslint --cache --cache-location .eslintcache --fix --concurrency=auto",
    "eslint": "eslint --cache --cache-location .eslintcache --concurrency=auto",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss,sass}\" --cache --cache-location .stylelintcache --fix;",
    "stylelint": "stylelint \"src/**/*.{css,scss,sass}\" --cache --cache-location .stylelintcache",
    "typed-scss-modules": "typed-scss-modules src --nameFormat none --exportType default --banner \"/* eslint-disable jsdoc/require-jsdoc, @typescript-eslint/consistent-type-definitions */\n// prettier-ignore\" --logLevel info --exportTypeName ClassNames --exportTypeInterface Styles --includePaths src --includePaths node_modules",
    "prettier": "prettier --check --cache .",
    "prettier:fix": "prettier --write --cache .",
    "knip": "NODE_OPTIONS=\"--max-old-space-size=8192\" knip",
    "browserslist:update": "update-browserslist-db"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "js-cookie": "^3.0.7",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-awesome-reveal": "^4.3.1",
    "react-dom": "19.2.6",
    "react-ga4": "^3.0.1",
    "react-use": "^17.6.0",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@cspell/dict-fr-fr": "^2.3.2",
    "@eslint/js": "^9.39.4",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.12.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "cspell": "^10.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.10.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "knip": "^6.14.1",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.14",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.1",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "stylelint-order": "^8.1.1",
    "typed-scss-modules": "^8.1.1",
    "typescript-eslint": "^8.59.3"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "serialize-javascript": "^7.0.5"
  }
}
