{
  "name": "kirian-caumes-website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "26.x.x"
  },
  "scripts": {
    "build": "next build",
    "cspell": "npx cspell ./ --no-progress --dot --gitignore",
    "dev": "next dev",
    "prepare": "husky",
    "start": "next start",
    "eslint:fix": "eslint --cache --cache-location .eslintcache --fix --concurrency=auto",
    "eslint": "eslint --cache --cache-location .eslintcache --concurrency=auto",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss,sass}\" --cache --cache-location .stylelintcache --fix;",
    "stylelint": "stylelint \"src/**/*.{css,scss,sass}\" --cache --cache-location .stylelintcache",
    "typed-scss-modules": "typed-scss-modules src --nameFormat none --exportType default --banner \"/* eslint-disable jsdoc/require-jsdoc, @typescript-eslint/consistent-type-definitions */\n// prettier-ignore\" --logLevel info --exportTypeName ClassNames --exportTypeInterface Styles --includePaths src --includePaths node_modules",
    "prettier": "prettier --check --cache .",
    "prettier:fix": "prettier --write --cache .",
    "knip": "NODE_OPTIONS=\"--max-old-space-size=8192\" knip",
    "browserslist:update": "update-browserslist-db"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "js-cookie": "^3.0.8",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-awesome-reveal": "^5.0.0",
    "react-dom": "19.3.1",
    "react-ga4": "^3.0.1",
    "react-use": "^17.6.1",
    "sass": "^1.108.1",
    "sharp": "^0.35.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@cspell/dict-fr-fr": "^2.3.2",
    "@eslint/js": "^9.39.5",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "cspell": "^10.4.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "stylelint-order": "^8.1.3",
    "typed-scss-modules": "^8.1.1",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "serialize-javascript": "^7.0.5",
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "^4.0.2"
    }
  }
}
